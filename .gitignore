# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# إعدادات Claude المحلية — قائمة أوامر خاصة بالجهاز، لا بالمشروع
.claude/settings.local.json

# local data — القاعدة تُبنى من المصادر عبر `bun run pipeline`
/data/
*.db
*.db-*
.venv/
__pycache__/

# vercel
.vercel

# temp / chrome
chrome-profile/
*.png
*.tar.gz

# typescript
*.tsbuildinfo
next-env.d.ts
